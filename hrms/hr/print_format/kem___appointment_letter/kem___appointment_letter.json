 "format_data": "{\"header\":\"<div class=\\\"document-header\\\" style=\\\"text-align: center; margin-top: 20px;\\\">\\r\\n\\t<h3>Appointment Letter</h3>\\r\\n</div>\\r\\n\",\"sections\":[{\"label\":\"Applicant Details\",\"columns\":[{\"label\":\"\",\"fields\":[{\"label\":\"Applicant Name\",\"fieldname\":\"applicant_name\",\"fieldtype\":\"Data\"}]},{\"label\":\"\",\"fields\":[{\"label\":\"Appointment Date\",\"fieldname\":\"appointment_date\",\"fieldtype\":\"Date\"}]},{\"label\":\"\",\"fields\":[{\"label\":\"Job Applicant\",\"fieldname\":\"job_applicant\",\"fieldtype\":\"Link\",\"options\":\"Job Applicant\"}]}],\"has_fields\":true,\"page_break\":false},{\"label\":\"\",\"columns\":[{\"label\":\"\",\"fields\":[{\"label\":\"Introduction\",\"fieldname\":\"introduction\",\"fieldtype\":\"Long Text\"},{\"label\":\"Spacer\",\"fieldname\":\"spacer\",\"fieldtype\":\"Spacer\"},{\"label\":\"Terms & Conditions:\",\"fieldname\":\"terms\",\"fieldtype\":\"Table\",\"options\":\"Appointment Letter content\",\"table_columns\":[{\"label\":\"Title\",\"fieldname\":\"title\",\"fieldtype\":\"Data\",\"width\":10},{\"label\":\"Description\",\"fieldname\":\"description\",\"fieldtype\":\"Long Text\",\"width\":10}]}]}],\"has_fields\":true}]}",
 "html": "<div style=\"width: 100%; font-family: 'Noto Sans Devanagari', Arial, sans-serif; padding: 20px; box-sizing: border-box;\">\r\n\r\n  <!-- Header / Logo -->\r\n  <div style=\"text-align: center; margin-bottom: 10px;\">\r\n    <img src=\"/files/logo.png\" alt=\"Artem Health Tech Logo\" style=\"max-height: 80px;\">\r\n  </div>\r\n\r\n  <h2 style=\"text-align: center; margin-bottom: 5px;\">\u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u092a\u0924\u094d\u0930</h2>\r\n  <p style=\"text-align: center; font-size: 14px; color: #555;\">{{ doc.appointment_date }} \u0930\u094b\u091c\u0940\u091a\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940</p>\r\n\r\n  <hr style=\"margin: 20px 0;\">\r\n\r\n  <!-- Employee Details -->\r\n  <table style=\"width: 100%; font-size: 14px; margin-bottom: 20px;\">\r\n    <tr>\r\n      <td><strong>\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0928\u093e\u0935:</strong></td>\r\n      <td>{{ doc.applicant_name }}</td>\r\n      <td><strong>\u0908\u092e\u0947\u0932:</strong></td>\r\n      <td>{{ doc.job_applicant }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td><strong>\u0930\u0941\u0917\u094d\u0923\u093e\u0932\u092f:</strong></td>\r\n      <td colspan=\"3\">{{ doc.company }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Introduction -->\r\n  <h3 style=\"margin-top: 30px; border-bottom: 1px solid #ccc;\">\u092a\u0930\u093f\u091a\u092f</h3>\r\n  <p>\r\n    \u092a\u094d\u0930\u093f\u092f {{ doc.applicant_name }},<br><br>\r\n    \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0906\u0928\u0902\u0926 \u0939\u094b\u0924 \u0906\u0939\u0947 \u0915\u0940 \u0906\u092a\u0923\u093e\u0938 <strong>{{ doc.company }}</strong> \u092f\u0947\u0925\u0947 <strong>Doctor (MD)</strong> \u092e\u094d\u0939\u0923\u0942\u0928 <strong>Radiology</strong> \u0935\u093f\u092d\u093e\u0917\u093e\u0924 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u093e \u0906\u0939\u0947.\r\n    \u0906\u092a\u0932\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 <strong>{{ doc.appointment_date }}</strong> \u092a\u093e\u0938\u0942\u0928 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0930\u093e\u0939\u0940\u0932 \u0906\u0923\u093f \u0906\u092a\u0932\u0947 \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933 <strong>Mumbai</strong> \u092f\u0947\u0925\u0947 \u0930\u093e\u0939\u0940\u0932.\r\n  </p>\r\n  <p>\r\n    \u0906\u092a\u0932\u094d\u092f\u093e \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u092a\u093e\u0924\u094d\u0930\u0924\u0947\u091a\u093e \u0906\u0923\u093f \u0905\u0928\u0941\u092d\u0935\u093e\u091a\u093e \u0906\u092e\u091a\u094d\u092f\u093e \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0938\u0947\u0935\u0947\u0924 \u0928\u093f\u0936\u094d\u091a\u093f\u0924\u091a \u092e\u094b\u0920\u093e \u092b\u093e\u092f\u0926\u093e \u0939\u094b\u0908\u0932, \u092f\u093e\u091a\u0940 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947.\r\n  </p>\r\n  <p>\u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0932\u0940 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940 \u0935\u093e\u091a\u0942\u0928 \u0906\u092a\u0932\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u0940 \u0926\u0930\u094d\u0936\u0935\u093e\u0935\u0940.</p>\r\n\r\n  <!-- Terms & Conditions -->\r\n  <h3 style=\"margin-top: 30px; border-bottom: 1px solid #ccc;\">\u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940</h3>\r\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\" border=\"1\">\r\n    <thead>\r\n      <tr style=\"background: #f2f2f2;\">\r\n        <th style=\"padding: 8px;\">\u0936\u093f\u0930\u094d\u0937\u0915</th>\r\n        <th style=\"padding: 8px;\">\u0935\u093f\u0935\u0930\u0923</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u092a\u0926\u0928\u093e\u092e</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923\u093e\u0938 Doctor (MD) \u092e\u094d\u0939\u0923\u0942\u0928 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947. \u0906\u092a\u0923 \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0905\u0927\u0940\u0915\u094d\u0937\u0915 \u0915\u093f\u0902\u0935\u093e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928\u093e\u0928\u0947 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0902\u0928\u093e \u0905\u0939\u0935\u093e\u0932 \u0926\u094d\u092f\u093e\u0932.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u0947 \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933 Mumbai \u0930\u093e\u0939\u0940\u0932. \u0917\u0930\u091c\u0947\u0928\u0941\u0938\u093e\u0930, \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u094d\u092f\u093e \u0907\u0924\u0930 \u092f\u0941\u0928\u093f\u091f\u094d\u0938\u092e\u0927\u094d\u092f\u0947 \u0926\u0947\u0916\u0940\u0932 \u0906\u092a\u0932\u0940 \u0938\u0947\u0935\u093e \u092e\u093e\u0917\u0935\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0935\u0947\u0924\u0928</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923\u093e\u0938 \u20b91,00,000 \u092e\u093e\u0938\u093f\u0915 \u090f\u0915\u0942\u0923 \u0935\u0947\u0924\u0928 \u092e\u093f\u0933\u0947\u0932. \u0939\u0947 \u0935\u0947\u0924\u0928 \u0932\u093e\u0917\u0942 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u092a\u093e\u0924\u0940\u0928\u0902\u0924\u0930 \u0926\u093f\u0932\u0947 \u091c\u093e\u0908\u0932.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u092a\u0930\u0940\u0915\u094d\u0937\u093e\u0915\u093e\u0932</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u0938\u0941\u0930\u0941\u0935\u093e\u0924\u0940\u0938 \u0969 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u093e\u0915\u093e\u0932\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0947\u0932. \u0938\u092e\u093e\u0927\u093e\u0928\u0915\u093e\u0930\u0915 \u0915\u093e\u092e\u0917\u093f\u0930\u0940\u0928\u0902\u0924\u0930 \u0924\u0940 \u0915\u093e\u092f\u092e \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0915\u093e\u0930\u094d\u092f \u0935\u0947\u0933</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u0947 \u0915\u093e\u092e\u093e\u091a\u0947 \u0935\u0947\u0933 \u0939\u0949\u0938\u094d\u092a\u093f\u091f\u0932\u091a\u094d\u092f\u093e \u0927\u094b\u0930\u0923\u093e\u0928\u0941\u0938\u093e\u0930 \u0905\u0938\u0924\u0940\u0932. \u092f\u093e\u0924 \u0936\u093f\u092b\u094d\u091f, \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0947\u0935\u093e \u0915\u093f\u0902\u0935\u093e \u0911\u0928-\u0915\u0949\u0932 \u0921\u094d\u092f\u0941\u091f\u0940 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0905\u0938\u0942 \u0936\u0915\u0924\u093e\u0924.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0930\u091c\u093e</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u094d\u092f\u093e \u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0927\u094b\u0930\u0923\u093e\u0928\u0941\u0938\u093e\u0930 \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f, \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0906\u0923\u093f \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0930\u091c\u093e \u092e\u093f\u0933\u0924\u0940\u0932.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0938\u0947\u0935\u093e \u0938\u092e\u093e\u092a\u094d\u0924\u0940</td>\r\n        <td style=\"padding: 8px;\">\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092c\u093e\u091c\u0942 \u0969\u0966 \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u093e \u092a\u0942\u0930\u094d\u0935\u0938\u0942\u091a\u0928\u093e \u0915\u093e\u0932\u093e\u0935\u0927\u0940 \u0926\u0947\u090a\u0928 \u0915\u093f\u0902\u0935\u093e \u090f\u0915 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u091a\u0947 \u0935\u0947\u0924\u0928 \u0926\u0947\u090a\u0928 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0942 \u0936\u0915\u0924\u0947.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0906\u091a\u093e\u0930\u0938\u0902\u0939\u093f\u0924\u093e</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923 \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u094d\u092f\u093e \u0938\u0930\u094d\u0935 \u0928\u093f\u092f\u092e \u0935 \u0906\u091a\u093e\u0930\u0938\u0902\u0939\u093f\u0924\u093e \u092a\u093e\u0933\u0923\u0947 \u092c\u0902\u0927\u0928\u0915\u093e\u0930\u0915 \u0906\u0939\u0947.</td>\r\n      </tr>\r\n      <tr>\r\n        <td style=\"padding: 8px;\">\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e</td>\r\n        <td style=\"padding: 8px;\">\u0930\u0941\u0917\u094d\u0923\u093e\u0902\u091a\u0940 \u0935 \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0917\u094b\u092a\u0928\u0940\u092f \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u091a\u0940 \u0906\u092a\u0932\u0940 \u091c\u092c\u093e\u092c\u0926\u093e\u0930\u0940 \u0905\u0938\u0947\u0932. \u0924\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u0940\u0924 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937\u093e\u0932\u093e \u0926\u0947\u0923\u0947 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0920\u0930\u0947\u0932.</td>\r\n      </tr>\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Closing Note -->\r\n  <h3 style=\"margin-top: 30px; border-bottom: 1px solid #ccc;\">\u0938\u092e\u093e\u0930\u094b\u092a</h3>\r\n  <p>\r\n    \u0906\u092a\u0932\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0905\u092d\u093f\u092e\u093e\u0928 \u0935\u093e\u091f\u0924\u094b \u0906\u0923\u093f \u0906\u092a\u0932\u094d\u092f\u093e\u0915\u0921\u0942\u0928 \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0915\u093e\u092e\u0917\u093f\u0930\u0940\u091a\u0940 \u0905\u092a\u0947\u0915\u094d\u0937\u093e \u0920\u0947\u0935\u0924\u094b.\r\n    \u0915\u0943\u092a\u092f\u093e \u092f\u093e \u092a\u0924\u094d\u0930\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0940\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0926\u094d\u092f\u093e \u0906\u0923\u093f \u0906\u092a\u0932\u0940 \u0938\u0939\u092e\u0924\u0940 \u0926\u0930\u094d\u0936\u0935\u093e.\r\n  </p>\r\n\r\n  <p style=\"margin-top: 30px;\">\u0906\u092a\u0932\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0942,</p>\r\n  <p><strong>{{ doc.company }}</strong></p>\r\n\r\n</div>\r\n",
