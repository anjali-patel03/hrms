 "html": "{% set terms_exist = doc.terms and (doc.terms|striptags).strip() or \"\" %}\r\n\r\n{% if letter_head and not no_letterhead -%}\r\n    <div class=\"letter-head\">{{ letter_head }}</div>\r\n    <hr>\r\n{%- endif %}\r\n\r\n<div {% if terms_exist -%} class=\"page-break\" {%- endif %}>\r\n\r\n<h2 style=\"text-align: center;\">\u0928\u094b\u0915\u0930\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940\u092a\u0924\u094d\u0930</h2>\r\n\r\n<p>\r\n<strong>\u0926\u093f\u0928\u093e\u0902\u0915:</strong> {{ frappe.utils.formatdate(doc.offer_date) }}\r\n<br><br>\r\n\r\n<strong>\u092a\u094d\u0930\u093f\u092f {{ doc.applicant_name }},</strong>\r\n<br><br>\r\n\r\n\u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0905\u0924\u094d\u092f\u0902\u0924 \u0906\u0928\u0902\u0926 \u0939\u094b\u0924 \u0906\u0939\u0947 \u0915\u0940 \u0906\u092e\u094d\u0939\u0940 \u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e <strong>{{ doc.company }}</strong> \u092e\u0927\u094d\u092f\u0947 {{ doc.designation }} \u092f\u093e \u092a\u0926\u093e\u0935\u0930 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0930\u0924 \u0906\u0939\u094b\u0924. \u0906\u092a\u0932\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 <strong>{{ frappe.utils.formatdate(doc.date_of_joining) }}</strong> \u092a\u093e\u0938\u0942\u0928 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0930\u093e\u0939\u0940\u0932. \u0906\u092a\u0932\u0947 \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933 <strong>{{ doc.branch or \"\u092e\u0941\u0902\u092c\u0908\" }}</strong> \u092f\u0947\u0925\u0947 \u0930\u093e\u0939\u0940\u0932.\r\n<br><br>\r\n\r\n\u0906\u092a\u0932\u094d\u092f\u093e \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u092a\u093e\u0924\u094d\u0930\u0924\u0947\u091a\u093e \u0935 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0905\u0928\u0941\u092d\u0935\u093e\u091a\u093e \u0938\u0902\u0938\u094d\u0925\u0947\u0938 \u0928\u093f\u0936\u094d\u091a\u093f\u0924\u091a \u092e\u094b\u0920\u093e \u092b\u093e\u092f\u0926\u093e \u0939\u094b\u0908\u0932, \u092f\u093e\u091a\u0940 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947.\r\n<br><br>\r\n\r\n<strong>\u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940\u091a\u094d\u092f\u093e \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940:</strong>\r\n<br><br>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse;\" border=\"1\">\r\n    <tr>\r\n        <th style=\"padding: 8px;\">\u0905\u091f</th>\r\n        <th style=\"padding: 8px;\">\u0935\u093f\u0935\u0930\u0923</th>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u092a\u0926\u0928\u093e\u092e</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923\u093e\u0938 \u0915\u0902\u092a\u0928\u0940\u092e\u0927\u094d\u092f\u0947 {{ doc.designation }} \u092f\u093e \u092a\u0926\u093e\u0935\u0930 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092f\u0947\u0924 \u0906\u0939\u0947.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940\u091a\u0940 \u0924\u093e\u0930\u0940\u0916</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 {{ frappe.utils.formatdate(doc.date_of_joining) }} \u092a\u093e\u0938\u0942\u0928 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0930\u093e\u0939\u0940\u0932.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0932\u0947 \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0933 {{ doc.branch or \"\u092e\u0941\u0902\u092c\u0908\" }} \u0930\u093e\u0939\u0940\u0932. \u0917\u0930\u091c\u0947\u0928\u0941\u0938\u093e\u0930, \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u094d\u092f\u093e \u0907\u0924\u0930 \u0920\u093f\u0915\u093e\u0923\u0940 \u0915\u093e\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0905\u092a\u0947\u0915\u094d\u0937\u093e \u0920\u0947\u0935\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u0935\u0947\u0924\u0928</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923\u093e\u0938 \u092e\u0941\u0932\u093e\u0916\u0924\u0940\u0924 \u0920\u0930\u0932\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0935\u0947\u0924\u0928 \u0926\u093f\u0932\u0947 \u091c\u093e\u0908\u0932.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u092a\u0930\u0940\u0915\u094d\u0937\u093e\u0915\u093e\u0932</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923 \u0938\u0941\u0930\u0941\u0935\u093e\u0924\u0940\u0938 \u0969 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u093e\u0915\u093e\u0932\u093e\u0938\u093e\u0920\u0940 \u0928\u0947\u092e\u0923\u0941\u0915\u0940\u0935\u0930 \u0930\u093e\u0939\u093e\u0932. \u092f\u093e \u0915\u093e\u0932\u093e\u0935\u0927\u0940\u0928\u0902\u0924\u0930 \u0906\u092a\u0932\u0940 \u0915\u093e\u092e\u0917\u093f\u0930\u0940 \u092a\u093e\u0939\u0942\u0928 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u0915\u093e\u092e\u093e\u091a\u0947 \u0935\u0947\u0933</td>\r\n        <td style=\"padding: 8px;\">\u0915\u093e\u092e\u093e\u091a\u0947 \u0935\u0947\u0933 \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u0927\u094b\u0930\u0923\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0905\u0938\u0924\u0940\u0932. \u0915\u093e\u0939\u0940 \u092a\u094d\u0930\u0938\u0902\u0917\u0940 \u0936\u093f\u092b\u094d\u091f \u0921\u094d\u092f\u0941\u091f\u0940 \u0915\u093f\u0902\u0935\u093e \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0935\u0947\u0933 \u0915\u093e\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0932\u093e\u0917\u0942 \u0936\u0915\u0924\u0947.</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"padding: 8px;\">\u0930\u091c\u093e</td>\r\n        <td style=\"padding: 8px;\">\u0906\u092a\u0923\u093e\u0938 \u0930\u091c\u093e \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u0928\u093f\u092f\u092e\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u092e\u093f\u0933\u0947\u0932, \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0938\u0936\u0941\u0932\u094d\u0915 \u0938\u0941\u091f\u094d\u091f\u0940, \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0930\u091c\u093e, \u0906\u0923\u093f \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0930\u091c\u093e \u092f\u093e\u0902\u091a\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0906\u0939\u0947.</td>\r\n    </tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<strong>\u0915\u0943\u092a\u092f\u093e \u0935\u0930\u0940\u0932 \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u091a\u093e.</strong> \u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e \u0915\u093e\u0939\u0940 \u0936\u0902\u0915\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0915\u0943\u092a\u092f\u093e \u0906\u092e\u094d\u0939\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.\r\n<br><br>\r\n\r\n<strong>{{ doc.company }}</strong> \u092e\u0927\u094d\u092f\u0947 \u0906\u092a\u0932\u0947 \u092e\u0928\u0903\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947. \u0906\u092e\u094d\u0939\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u092c\u093e\u0933\u0917\u0924\u094b \u0915\u0940 \u0906\u092a\u0932\u0940 \u0906\u092e\u091a\u094d\u092f\u093e \u0938\u0902\u0938\u094d\u0925\u0947\u0938\u094b\u092c\u0924\u091a\u0940 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0935\u093e\u091f\u091a\u093e\u0932 \u092f\u0936\u0938\u094d\u0935\u0940 \u0935 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u0940\u0928 \u0920\u0930\u0947\u0932.\r\n<br><br>\r\n\r\n\u0906\u092a\u0932\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0942,\r\n<br><br>\r\n\r\n<strong>\u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940</strong><br>\r\n{{ doc.company }}\r\n\r\n</p>\r\n</div>\r\n\r\n{% if terms_exist %}\r\n<div>\r\n    <hr>\r\n    <h4>\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940:</h4>\r\n    {{ doc.terms }}\r\n</div>\r\n{% endif %}\r\n",
